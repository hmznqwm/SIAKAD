# SIAKAD Upload Security Configuration
# Prevent directory listing
Options -Indexes -ExecCGI

# Turn off PHP execution engine if supported
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block execution of any script files
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|phar|cgi|pl|exe|sh|bash|bat|cmd|html|htm|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Serve images and documents with strict content type headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
